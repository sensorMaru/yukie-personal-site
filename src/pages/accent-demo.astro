---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  accentReplacementRules,
  automaticAccentReplacementRules,
} from '../data/accent-replacements';
---

<BaseLayout
  title="口音发音转换 Demo"
  description="粘贴文字，仅对符合语境的少量发音进行转换；原句、词序与字幕保持不变。"
>
  <main class="accent-page">
    <header class="topbar">
      <a href="/" class="brand">YUKIE <span>✳</span></a>
      <span class="prototype-label">MINI PROTOTYPE</span>
    </header>

    <section class="intro">
      <p class="eyebrow">ACCENT LOCALIZER · TW</p>
      <h1>粘贴文字，<br /><span>只转换需要变化的发音。</span></h1>
      <p class="intro-copy">不改句意、不改词序。字幕保留原文，转换结果只作为配音输入稿。</p>
    </section>

    <section
      class="converter"
      data-converter
      data-corpus-rules={JSON.stringify(automaticAccentReplacementRules)}
      aria-label="口音发音转换工具"
    >
      <div class="converter-bar">
        <div>
          <span class="status-dot" aria-hidden="true"></span>
          <strong>台湾国语 · 轻量规则</strong>
        </div>
        <span>语料库：{accentReplacementRules.length} 条 · 自动 {automaticAccentReplacementRules.length} 条</span>
      </div>

      <div class="workspace">
        <section class="editor-panel" aria-labelledby="input-heading">
          <div class="panel-heading">
            <div><span>01</span><h2 id="input-heading">粘贴原文</h2></div>
            <button type="button" data-clear>清空</button>
          </div>
          <textarea
            data-input
            rows="8"
            maxlength="500"
            aria-describedby="input-help"
            placeholder="在这里粘贴需要处理的口播文字……"
          >我和你一起准备今天的拍摄。</textarea>
          <div class="editor-footer">
            <span id="input-help">字幕将保留这里的原文</span>
            <span data-character-count>14 / 500</span>
          </div>
          <div class="examples" aria-label="示例句">
            <span>示例</span>
            <button type="button" data-example="客廳我本來就放360系列。房間比較小，我就放這台。跟360系列比，它的占地大約少四成。擺在這裡也很搭，不會一眼只看到機器。開AI模式，它會自己偵測；空氣清新時就轉待機。不用重新挪家具，房間也放得下清淨機。">产品口播</button>
            <button type="button" data-example="乾燥環境需要即時處理，細緻質地能降低負荷，也更舒服。">语料库</button>
            <button type="button" data-example="我和你一起准备今天的拍摄。">我和你</button>
            <button type="button" data-example="我和她晚一点再确认内容。">我和她</button>
            <button type="button" data-example="我们都希望世界和平。">和平（不转换）</button>
          </div>
          <button class="convert-button" type="button" data-convert>
            转换为配音发音稿
            <span aria-hidden="true">→</span>
          </button>
        </section>

        <section class="result-panel" aria-labelledby="output-heading">
          <div class="panel-heading">
            <div><span>02</span><h2 id="output-heading">转换结果</h2></div>
            <span class="change-count" data-change-count>已调整 1 处</span>
          </div>

          <div class="result-card voice-card">
            <div class="result-label"><span>配音输入稿</span><small>发音替代字高亮</small></div>
            <p data-output aria-live="polite">我<mark>汗</mark>你一起准备今天的拍摄。</p>
          </div>

          <div class="rule-card" data-rule-card>
            <div class="rule-change">
              <span data-rule-from>和</span><i aria-hidden="true">→</i><span data-rule-to>汗</span>
            </div>
            <p data-rule-description>“和”连接人物时，将 hé 调整为台湾常用读音 hàn。</p>
          </div>

          <button class="copy-button" type="button" data-copy>
            <span data-copy-label>复制配音输入稿</span>
            <span aria-hidden="true">↗</span>
          </button>
          <p class="message" data-message role="status" aria-live="polite">转换只发生在配音稿，字幕内容没有变化。</p>
        </section>
      </div>

      <section class="audio-check" aria-labelledby="audio-heading">
        <div class="audio-check-heading">
          <div><span>03</span><h2 id="audio-heading">上传音频，二次检查</h2></div>
          <a href="/accent-audio-check/" target="_blank" rel="noreferrer">独立打开 ↗</a>
        </div>

        <div class="audio-check-grid">
          <label class="upload-zone" data-upload-zone>
            <input type="file" accept="audio/*,.wav,.mp3,.m4a" data-audio-input />
            <span class="upload-symbol" aria-hidden="true">＋</span>
            <strong>丢入生成后的配音音频</strong>
            <span>支持 WAV、MP3、M4A，音频仅用于本次分析</span>
          </label>

          <div class="audio-review">
            <div class="audio-file-row">
              <div>
                <span>待检音频</span>
                <strong data-audio-name>尚未选择文件</strong>
              </div>
              <span data-audio-duration>—</span>
            </div>
            <audio controls preload="metadata" data-audio-player hidden></audio>
            <label class="reference-toggle">
              <input type="checkbox" data-use-script-reference />
              <span>使用上方配音稿作为校验基准</span>
            </label>
            <button class="analyze-button" type="button" data-analyze-audio disabled>
              <span data-analyze-label>开始二次检查</span>
              <span aria-hidden="true">→</span>
            </button>
            <p class="audio-status" data-audio-status role="status" aria-live="polite">默认只分析新上传的音频，不读取上方或上一次的文字。</p>
          </div>
        </div>

        <div class="audio-result" data-audio-result hidden>
          <div class="audio-result-summary">
            <span>检查结果</span>
            <strong data-audio-summary></strong>
          </div>
          <div class="audio-verdict" data-audio-verdict>
            <span class="audio-verdict-icon" data-audio-verdict-icon aria-hidden="true">✓</span>
            <div>
              <strong data-audio-verdict-title></strong>
              <p data-audio-verdict-detail></p>
            </div>
          </div>
          <ul class="audio-check-list" data-audio-check-list></ul>
        </div>
      </section>

      <footer class="converter-footer">
        <span>规则边界</span>
        <p><strong>只自动处理明确规则。</strong>数字型号按位读、英文字母拆读；“和”只在连接人物时转换，“和平、和谐”不会误改，完整词“溫和”则按语料库规则处理。</p>
      </footer>
    </section>
  </main>
</BaseLayout>

<script>
  const converter = document.querySelector<HTMLElement>('[data-converter]');

  if (converter) {
    const input = converter.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const output = converter.querySelector<HTMLElement>('[data-output]')!;
    const changeCount = converter.querySelector<HTMLElement>('[data-change-count]')!;
    const ruleCard = converter.querySelector<HTMLElement>('[data-rule-card]')!;
    const characterCount = converter.querySelector<HTMLElement>('[data-character-count]')!;
    const message = converter.querySelector<HTMLElement>('[data-message]')!;
    const copyLabel = converter.querySelector<HTMLElement>('[data-copy-label]')!;
    const ruleFrom = converter.querySelector<HTMLElement>('[data-rule-from]')!;
    const ruleTo = converter.querySelector<HTMLElement>('[data-rule-to]')!;
    const ruleDescription = converter.querySelector<HTMLElement>('[data-rule-description]')!;
    const uploadZone = converter.querySelector<HTMLElement>('[data-upload-zone]')!;
    const audioInput = converter.querySelector<HTMLInputElement>('[data-audio-input]')!;
    const audioName = converter.querySelector<HTMLElement>('[data-audio-name]')!;
    const audioDuration = converter.querySelector<HTMLElement>('[data-audio-duration]')!;
    const audioPlayer = converter.querySelector<HTMLAudioElement>('[data-audio-player]')!;
    const useScriptReference = converter.querySelector<HTMLInputElement>('[data-use-script-reference]')!;
    const analyzeButton = converter.querySelector<HTMLButtonElement>('[data-analyze-audio]')!;
    const analyzeLabel = converter.querySelector<HTMLElement>('[data-analyze-label]')!;
    const audioStatus = converter.querySelector<HTMLElement>('[data-audio-status]')!;
    const audioResult = converter.querySelector<HTMLElement>('[data-audio-result]')!;
    const audioSummary = converter.querySelector<HTMLElement>('[data-audio-summary]')!;
    const audioVerdict = converter.querySelector<HTMLElement>('[data-audio-verdict]')!;
    const audioVerdictIcon = converter.querySelector<HTMLElement>('[data-audio-verdict-icon]')!;
    const audioVerdictTitle = converter.querySelector<HTMLElement>('[data-audio-verdict-title]')!;
    const audioVerdictDetail = converter.querySelector<HTMLElement>('[data-audio-verdict-detail]')!;
    const audioCheckList = converter.querySelector<HTMLUListElement>('[data-audio-check-list]')!;

    const peopleWords = [
      '我们', '你们', '他们', '她们', '大家', '同事', '朋友', '妈妈', '爸爸', '客户', '团队',
      '我', '你', '他', '她', '它',
    ];
    type CorpusRule = { source: string; replacement: string; note?: string };
    const corpusRules: CorpusRule[] = JSON.parse(converter.dataset.corpusRules || '[]');
    let voiceText = '';
    let appliedAudioRules: AppliedRule[] = [];
    let selectedAudio: File | null = null;
    let selectedAudioUrl = '';

    const digitNames: Record<string, string> = {
      '0': '零', '1': '一', '2': '二', '3': '三', '4': '四',
      '5': '五', '6': '六', '7': '七', '8': '八', '9': '九',
    };

    const isPeopleConjunction = (text: string, index: number) => {
      const left = text.slice(0, index);
      const right = text.slice(index + 1);
      return peopleWords.some(word => left.endsWith(word)) && peopleWords.some(word => right.startsWith(word));
    };

    type AppliedRule = {
      id: string;
      source: string;
      replacement: string;
      description: string;
    };

    const findRule = (text: string, index: number): (AppliedRule & { length: number }) | null => {
      if (text.slice(index, index + 2).toUpperCase() === 'AI') {
        return {
          id: 'letters-ai',
          length: 2,
          source: text.slice(index, index + 2),
          replacement: 'A I ',
          description: 'AI 拆成两个字母读，避免语音模型连读成“爱”。',
        };
      }

      const numberMatch = text.slice(index).match(/^\d+(?=\s*系列)/);
      if (numberMatch) {
        return {
          id: 'model-number',
          length: numberMatch[0].length,
          source: numberMatch[0],
          replacement: [...numberMatch[0]].map(digit => digitNames[digit] || digit).join(''),
          description: '系列名称中的数字逐位读，避免被读成完整数值。',
        };
      }

      if (text[index] === '和' && isPeopleConjunction(text, index)) {
        return {
          id: 'people-conjunction',
          length: 1,
          source: '和',
          replacement: '汗',
          description: '“和”连接人物时，将 hé 调整为台湾常用读音 hàn。',
        };
      }

      const corpusRule = corpusRules.find(rule => {
        const candidate = text.slice(index, index + rule.source.length);
        return /[A-Za-z]/.test(rule.source)
          ? candidate.toUpperCase() === rule.source.toUpperCase()
          : candidate === rule.source;
      });
      if (corpusRule) {
        return {
          id: `corpus-${corpusRule.source}`,
          length: corpusRule.source.length,
          source: text.slice(index, index + corpusRule.source.length),
          replacement: corpusRule.replacement,
          description: corpusRule.note || `来自 UGC TTS 替换语料库：将“${corpusRule.source}”改写为发音输入“${corpusRule.replacement}”。`,
        };
      }

      return null;
    };

    const render = () => {
      const source = input.value.trim();
      const fragments: Array<{ value: string; changed: boolean }> = [];
      const appliedRules: AppliedRule[] = [];

      for (let index = 0; index < source.length;) {
        const rule = findRule(source, index);
        if (rule) {
          fragments.push({ value: rule.replacement, changed: true });
          appliedRules.push(rule);
          index += rule.length;
        } else {
          fragments.push({ value: source[index], changed: false });
          index += 1;
        }
      }

      voiceText = fragments.map(fragment => fragment.value).join('');
      output.replaceChildren(...fragments.map(fragment => {
        const element = document.createElement(fragment.changed ? 'mark' : 'span');
        element.textContent = fragment.value;
        return element;
      }));
      if (!source) output.textContent = '等待转换结果';

      const changes = appliedRules.length;
      appliedAudioRules = appliedRules;
      const groupedRules = [...new Map(appliedRules.map(rule => [rule.id, rule])).values()];
      changeCount.textContent = changes ? `已调整 ${changes} 处` : '无需调整';
      changeCount.dataset.empty = String(changes === 0);
      ruleCard.hidden = changes === 0;
      if (groupedRules.length) {
        ruleFrom.textContent = groupedRules.map(rule => rule.source).join('／');
        ruleTo.textContent = groupedRules.map(rule => rule.replacement.trim()).join('／');
        ruleDescription.textContent = groupedRules.map(rule => rule.description).join(' ');
      }
      message.textContent = !source
        ? '请先粘贴需要处理的文字。'
        : changes
          ? '转换只发生在配音稿，字幕内容没有变化。'
          : '当前文字没有命中演示规则，内容保持不变。';
      characterCount.textContent = `${input.value.length} / 500`;
      copyLabel.textContent = '复制配音输入稿';
    };

    input.addEventListener('input', () => {
      characterCount.textContent = `${input.value.length} / 500`;
      if (selectedAudio && useScriptReference.checked) audioStatus.textContent = '原文已修改；检查时会按当前文字重新生成发音稿。';
    });
    useScriptReference.addEventListener('change', () => {
      audioResult.hidden = true;
      audioStatus.textContent = useScriptReference.checked
        ? '本次将使用上方当前配音稿校验；不会读取上一次的检查结果。'
        : '已切换为独立听音；本次不读取上方或上一次的文字。';
    });
    input.addEventListener('keydown', event => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') render();
    });
    converter.querySelector('[data-convert]')!.addEventListener('click', render);
    converter.querySelector('[data-clear]')!.addEventListener('click', () => {
      input.value = '';
      render();
      input.focus();
    });
    converter.querySelectorAll<HTMLButtonElement>('[data-example]').forEach(button => {
      button.addEventListener('click', () => {
        input.value = button.dataset.example || '';
        render();
      });
    });
    converter.querySelector('[data-copy]')!.addEventListener('click', async () => {
      if (!voiceText) {
        message.textContent = '请先粘贴并转换文字。';
        return;
      }
      try {
        await navigator.clipboard.writeText(voiceText);
        copyLabel.textContent = '已复制';
        message.textContent = '配音输入稿已复制；字幕请继续使用原稿。';
      } catch {
        message.textContent = '浏览器未允许自动复制，请选中结果手动复制。';
      }
    });

    const loadAudio = (file: File | null) => {
      selectedAudio = file;
      audioResult.hidden = true;
      if (selectedAudioUrl) URL.revokeObjectURL(selectedAudioUrl);

      if (!file) {
        audioName.textContent = '尚未选择文件';
        audioDuration.textContent = '—';
        audioPlayer.hidden = true;
        analyzeButton.disabled = true;
        audioStatus.textContent = '默认只分析新上传的音频，不读取上方或上一次的文字。';
        return;
      }

      const supported = file.type.startsWith('audio/') || /\.(wav|mp3|m4a)$/i.test(file.name);
      if (!supported) {
        selectedAudio = null;
        audioName.textContent = '文件格式不支持';
        audioDuration.textContent = '—';
        audioPlayer.hidden = true;
        analyzeButton.disabled = true;
        audioStatus.textContent = '请拖入 WAV、MP3 或 M4A 音频文件。';
        return;
      }

      selectedAudioUrl = URL.createObjectURL(file);
      audioPlayer.src = selectedAudioUrl;
      audioPlayer.hidden = false;
      audioName.textContent = `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} MB`;
      audioDuration.textContent = '读取中';
      analyzeButton.disabled = false;
      audioStatus.textContent = useScriptReference.checked
        ? '音频已载入，将与上方当前配音稿核对。'
        : '音频已载入，将独立识别并听音，不使用已有文字。';
    };

    audioInput.addEventListener('change', () => {
      loadAudio(audioInput.files?.[0] || null);
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      uploadZone.addEventListener(eventName, event => {
        event.preventDefault();
        event.stopPropagation();
        uploadZone.classList.add('is-dragging');
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      uploadZone.addEventListener(eventName, event => {
        event.preventDefault();
        event.stopPropagation();
        uploadZone.classList.remove('is-dragging');
      });
    });

    uploadZone.addEventListener('drop', event => {
      const file = event.dataTransfer?.files?.[0] || null;
      loadAudio(file);
    });

    audioPlayer.addEventListener('loadedmetadata', () => {
      if (Number.isFinite(audioPlayer.duration)) audioDuration.textContent = `${audioPlayer.duration.toFixed(1)} 秒`;
    });

    analyzeButton.addEventListener('click', async () => {
      if (!selectedAudio) {
        audioStatus.textContent = '请先上传需要检查的音频。';
        return;
      }

      if (useScriptReference.checked) render();

      const groupedTargets = useScriptReference.checked ? [...appliedAudioRules.reduce((map, rule) => {
        const current = map.get(rule.id);
        if (current) current.count += 1;
        else map.set(rule.id, { ...rule, count: 1 });
        return map;
      }, new Map<string, AppliedRule & { count: number }>()).values()] : [];

      analyzeButton.disabled = true;
      analyzeLabel.textContent = '正在识别音频…';
      audioStatus.textContent = '正在核对实际语音与目标读音，请稍候。';
      audioResult.hidden = true;

      try {
        const query = new URLSearchParams({
          expected: useScriptReference.checked ? voiceText : '',
          targets: JSON.stringify(groupedTargets),
          duration: Number.isFinite(audioPlayer.duration) ? audioPlayer.duration.toFixed(1) : '',
        });
        const response = await fetch(`/api/analyze?${query}`, {
          method: 'POST',
          headers: { 'Content-Type': selectedAudio.type || 'audio/wav' },
          body: selectedAudio,
        });
        if (!response.ok) throw new Error('audio_analysis_failed');

        const result = await response.json();
        const visibleChecks = (result.checks || []).filter((check: { status: string }) => check.status !== 'pass');
        const warningCount = visibleChecks.filter((check: { status: string }) => check.status === 'warning').length;
        const reviewCount = visibleChecks.length - warningCount;
        const hasReference = result.referenceMode === 'script';
        const isInsufficient = result.quality?.status === 'insufficient';
        const needsGeneralReview = hasReference && result.quality?.status === 'review';

        if (warningCount > 0) {
          audioVerdict.dataset.status = 'warning';
          audioVerdictIcon.textContent = '!';
          audioVerdictTitle.textContent = `发现 ${warningCount} 处音频问题`;
          audioVerdictDetail.textContent = '检测到疑似错读、漏读或多读，请查看下方问题并点击复听。';
          audioSummary.textContent = `未通过 · ${result.duration} 秒`;
        } else if (reviewCount > 0 || isInsufficient || needsGeneralReview) {
          audioVerdict.dataset.status = 'review';
          audioVerdictIcon.textContent = '?';
          audioVerdictTitle.textContent = reviewCount > 0 ? `有 ${reviewCount} 处需要复听` : isInsufficient ? '暂时无法判断' : '建议复听音频';
          audioVerdictDetail.textContent = reviewCount > 0
            ? '没有发现明确错读，但部分发音置信度不足，需要人工确认。'
            : isInsufficient ? '音频识别不够稳定，请更换清晰音频后重新检查。' : '未发现明确错读，但识别结果不足以直接判定通过。';
          audioSummary.textContent = `待确认 · ${result.duration} 秒`;
        } else if (hasReference) {
          audioVerdict.dataset.status = 'pass';
          audioVerdictIcon.textContent = '✓';
          audioVerdictTitle.textContent = '音频没有问题';
          audioVerdictDetail.textContent = '未发现明显错读、漏读或多读。';
          audioSummary.textContent = `通过 · ${result.duration} 秒`;
        } else {
          audioVerdict.dataset.status = 'pass';
          audioVerdictIcon.textContent = '✓';
          audioVerdictTitle.textContent = '未发现明显发音问题';
          audioVerdictDetail.textContent = '本次仅检查发音；未提供原稿，不判断是否漏读。';
          audioSummary.textContent = `发音检查通过 · ${result.duration} 秒`;
        }

        audioCheckList.replaceChildren();

        if (visibleChecks.length) {
          visibleChecks.forEach((check: { source: string; replacement: string; status: string; detail: string; start?: number; end?: number }) => {
            const item = document.createElement('li');
            item.dataset.status = check.status;
            const badge = document.createElement('span');
            badge.textContent = check.status === 'warning'
              ? check.replacement === '未读出' ? '疑似漏读' : check.source === '原稿无' ? '疑似多读' : '疑似错读'
              : '需要复听';
            const copy = document.createElement('div');
            const title = document.createElement('strong');
            title.textContent = `${check.source} → ${check.replacement}`;
            const detail = document.createElement('p');
            detail.textContent = check.detail;
            copy.append(title, detail);
            item.append(badge, copy);
            if (typeof check.start === 'number') {
              item.classList.add('playable');
              item.title = '点击复听这一处';
              item.addEventListener('click', () => {
                audioPlayer.currentTime = check.start || 0;
                audioPlayer.play();
                window.setTimeout(() => audioPlayer.pause(), Math.max(900, ((check.end || check.start || 0) - (check.start || 0) + .7) * 1000));
              });
            }
            audioCheckList.append(item);
          });
        }
        audioResult.hidden = false;
        audioStatus.textContent = '二次检查已完成。';
      } catch {
        audioStatus.textContent = '在线语音检查暂时不可用，请稍后重试。';
      } finally {
        analyzeButton.disabled = false;
        analyzeLabel.textContent = '重新检查这段音频';
      }
    });

    render();
  }
</script>

