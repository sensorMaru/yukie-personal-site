---
import '../styles/global.css';

const { title, description = '' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d12" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
