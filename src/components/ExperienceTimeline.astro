---
import { experiences } from '../content/site';
---
<section class="experience-section" id="experience" aria-labelledby="experience-title">
  <div class="experience-heading">
    <p class="experience-kicker">01 / EXPERIENCE</p>
    <h2 id="experience-title">实习经历<span aria-hidden="true">✳</span></h2>
  </div>
  <ol class="experience-timeline" data-experience-timeline>
    <li class="timeline-track" aria-hidden="true"><span data-timeline-progress></span></li>
    {experiences.map((experience, index) => (
      <li class="experience-row" data-experience-row>
        <div class="experience-axis" aria-hidden="true">
          <span class="experience-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="experience-node"></span>
        </div>
        <div class="experience-summary">
          <p class="experience-date">{experience.period}</p>
          <h3>{experience.company}</h3>
          <p class="experience-team">{experience.team}</p>
          <p class="experience-role">{experience.role}</p>
          <ul class="experience-tags" aria-label="工作方向">{experience.tags.map(tag => <li>{tag}</li>)}</ul>
        </div>
        <div class="experience-card experience-scope">
          <h4>MY SCOPE <span>/ 我负责</span></h4>
          <p>{experience.scope}</p>
        </div>
        <div class="experience-card experience-output">
          <h4>OUTPUT <span>/ 产出与进展</span></h4>
          <p>{experience.output}</p>
          <p class="experience-status"><span aria-hidden="true"></span>{experience.status}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .experience-section{--exp-accent:#f87970;--exp-text:#fff3e9;--exp-muted:#d0b5b2;--exp-line:#ffffff20;position:relative;padding:44px 0 72px;color:var(--exp-text);scroll-margin-top:28px;background:transparent}
  .experience-heading{padding:0 20px;margin-bottom:36px}
  .experience-kicker{font-size:.8125rem;letter-spacing:.2em;color:var(--exp-accent);margin:0 0 18px}
  .experience-heading h2{display:flex;align-items:center;gap:24px;font-size:clamp(2rem,3.6vw,3.25rem);font-weight:500;letter-spacing:-.04em;margin:0}
  .experience-heading h2 span{font-size:.72em;color:var(--exp-accent);font-weight:400}
  .experience-timeline{--axis-x:39px;--track-top:55px;--track-height:calc(100% - 110px);position:relative;list-style:none;margin:0;padding:0;display:grid;gap:24px}
  .timeline-track{position:absolute;left:var(--axis-x);top:var(--track-top);height:var(--track-height);width:1px;background:#e0aba92c;pointer-events:none}
  .timeline-track span{display:block;width:100%;height:100%;background:linear-gradient(#c03b42,#ff9280);transform:scaleY(0);transform-origin:top;box-shadow:0 0 12px #eb535955}
  .experience-row{position:relative;isolation:isolate;display:grid;grid-template-columns:36px minmax(200px,.82fr) minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:stretch;padding:26px 20px 30px;border:1px solid transparent;border-radius:28px;transition:border-color .45s,box-shadow .45s}
  .experience-row::before{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:linear-gradient(115deg,#fff0df0d,#b4444424 60%,#e4705720);opacity:0;pointer-events:none;transition:opacity .45s cubic-bezier(.16,1,.3,1)}
  .experience-axis{position:relative}
  .experience-number{display:block;color:#c19b98;font-size:.8125rem;font-variant-numeric:tabular-nums;letter-spacing:.05em;text-align:center}
  .experience-node{position:absolute;left:50%;top:28px;transform:translate(-50%,-50%);width:17px;height:17px;border:1px solid #bb7978;border-radius:50%;background:#170a0c;display:grid;place-items:center;transition:border-color .5s,box-shadow .5s}
  .experience-node::after{content:'';width:5px;height:5px;background:#bb7978;border-radius:50%;transition:background .5s}
  .experience-row.is-passed .experience-node{border-color:#ff9486;box-shadow:0 0 0 5px #ed6a6013,0 0 18px #f4726740}
  .experience-row.is-passed .experience-node::after{background:#ff9486}
  .experience-summary{min-width:0;padding-top:0}
  .experience-date{margin:0 0 17px;color:var(--exp-muted);font-size:.875rem;letter-spacing:.08em;font-variant-numeric:tabular-nums}
  .experience-summary h3{margin:0;font-size:clamp(1.5rem,2.15vw,2.25rem);font-weight:500;line-height:1.25;letter-spacing:-.025em;overflow-wrap:anywhere}
  .experience-team{font-size:.9375rem;line-height:1.5;color:var(--exp-muted);margin:8px 0 0}
  .experience-role{font-size:1rem;color:#ffaaa0;margin:14px 0 0;line-height:1.5}
  .experience-tags{display:flex;flex-wrap:wrap;gap:7px;list-style:none;margin:18px 0 0;padding:0}
  .experience-tags li{font-size:.8125rem;line-height:1.45;padding:5px 10px;color:#ebcdc7;border:1px solid #f4bfb525;border-radius:20px;background:#ffffff03}
  .experience-card{min-width:0;border:1px solid var(--exp-line);border-radius:19px;padding:25px 24px;background:linear-gradient(145deg,#ffffff07,#ffffff02);transition:transform .4s cubic-bezier(.16,1,.3,1),border-color .4s,box-shadow .4s}
  .experience-card h4{font-size:.8125rem;letter-spacing:.12em;font-weight:500;color:#ffa79c;margin:0 0 18px;line-height:1.65}
  .experience-card h4 span{letter-spacing:.04em}
  .experience-card p{font-size:1rem;line-height:1.9;margin:0;overflow-wrap:anywhere}
  .experience-scope p{color:var(--exp-muted)}
  .experience-output{background:linear-gradient(140deg,#73202745,#42141955);border-color:#e47c6f36;display:flex;flex-direction:column}
  .experience-output .experience-status{font-size:.8125rem;line-height:1.6;margin-top:auto;padding-top:22px;color:#dcaeaa;display:flex;align-items:baseline;gap:8px}
  .experience-status span{width:5px;height:5px;flex-shrink:0;border-radius:50%;background:#f48a7c}
  /* Keep the axis fixed while the three content columns enter. */
  .experience-summary,.experience-card{translate:0 0;opacity:1;transition:translate .9s cubic-bezier(.16,1,.3,1),opacity .9s cubic-bezier(.16,1,.3,1),transform .4s,border-color .4s,box-shadow .4s}
  .experience-row.is-waiting .experience-summary,.experience-row.is-waiting .experience-card{translate:0 26px;opacity:0}
  .experience-row.is-revealing .experience-scope{transition-delay:.07s}
  .experience-row.is-revealing .experience-output{transition-delay:.14s}
  @media(hover:hover) and (pointer:fine){
    .experience-row:hover{border-color:#edb4a952;box-shadow:0 20px 54px -28px #000b,inset 0 1px 0 #fff0e508}
    .experience-row:hover::before{opacity:1}
    .experience-row:hover .experience-node{border-color:#ffc0ac;box-shadow:0 0 0 5px #f78a6e16,0 0 20px #ee735742}
    .experience-row:hover .experience-node::after{background:#ffc0ac}
    .experience-row:hover .experience-card{border-color:#edb09a45}
    .experience-row .experience-card:hover{transform:translateY(-4px);border-color:#ffb99e8c;box-shadow:0 18px 38px -25px #000c}
  }
  @media(max-width:1150px){.experience-row{grid-template-columns:36px minmax(0,1fr) minmax(0,1fr);gap:22px}.experience-axis{grid-row:1 / 3}.experience-summary{grid-column:2 / 4}.experience-scope{grid-column:2}.experience-output{grid-column:3}.experience-tags{margin-top:12px}.experience-summary h3{font-size:1.875rem}.experience-date{margin-bottom:10px}.experience-role{margin-top:8px}}
  @media(max-width:650px){.experience-section{padding:54px 0 40px}.experience-heading{padding:0 0 0 4px;margin-bottom:24px}.experience-heading h2{font-size:2rem}.experience-timeline{--axis-x:11px;gap:30px}.experience-row{padding:18px 0 24px;grid-template-columns:20px minmax(0,1fr);column-gap:16px;row-gap:16px;border-radius:0}.experience-axis{grid-row:1 / 4}.experience-summary,.experience-scope,.experience-output{grid-column:2}.experience-summary{padding-bottom:3px}.experience-card{padding:22px 20px}.experience-card h4{margin-bottom:12px}.experience-card p{line-height:1.8}.experience-date{font-size:.8125rem;letter-spacing:.03em}.experience-row:hover{background:transparent}}
  @media(max-width:650px){.experience-section{padding-top:32px}}
  @media(prefers-reduced-motion:reduce){.experience-row::before{transition:none!important}.experience-row,.experience-node,.experience-node::after,.experience-summary,.experience-card{transition:none!important;translate:none!important;transform:none!important;opacity:1!important}}
  @media print{.experience-summary,.experience-card{translate:none!important;opacity:1!important}.experience-row{break-inside:avoid}.timeline-track{display:none}}
</style>

<script>
  const timeline = document.querySelector<HTMLOListElement>('[data-experience-timeline]');
  if (timeline) {
    const rows = Array.from(timeline.querySelectorAll<HTMLElement>('[data-experience-row]'));
    const progress = timeline.querySelector<HTMLElement>('[data-timeline-progress]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let observer: IntersectionObserver | undefined;
    let frame = 0;
    const update = () => {
      frame = 0;
      const first = rows[0]?.querySelector<HTMLElement>('.experience-node');
      const last = rows.at(-1)?.querySelector<HTMLElement>('.experience-node');
      if (!first || !last || !progress) return;
      const bounds = timeline.getBoundingClientRect();
      const firstRect = first.getBoundingClientRect();
      const lastRect = last.getBoundingClientRect();
      const start = firstRect.top + firstRect.height / 2;
      const end = lastRect.top + lastRect.height / 2;
      const readingLine = window.innerHeight * .65;
      timeline.style.setProperty('--track-top', `${start - bounds.top}px`);
      timeline.style.setProperty('--track-height', `${Math.max(0, end - start)}px`);
      progress.style.transform = `scaleY(${reducedMotion.matches ? 1 : Math.max(0, Math.min(1, (readingLine - start) / Math.max(1, end - start)))})`;
      rows.forEach(row => {
        const node = row.querySelector('.experience-node')!;
        row.classList.toggle('is-passed', reducedMotion.matches || node.getBoundingClientRect().top <= readingLine);
      });
    };
    const queueUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
    const configureMotion = () => {
      observer?.disconnect();
      rows.forEach(row => row.classList.remove('is-waiting', 'is-revealing'));
      if (!reducedMotion.matches && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealing');
            entry.target.classList.remove('is-waiting');
            observer?.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: .05 });
        rows.forEach(row => {
          // Keep content already in view readable on direct anchor navigation.
          if (row.getBoundingClientRect().top >= window.innerHeight * .92) row.classList.add('is-waiting');
          observer?.observe(row);
        });
      }
      queueUpdate();
    };
    window.addEventListener('scroll', queueUpdate, { passive: true });
    window.addEventListener('resize', queueUpdate, { passive: true });
    window.addEventListener('load', queueUpdate, { once: true });
    reducedMotion.addEventListener('change', configureMotion);
    if ('ResizeObserver' in window) new ResizeObserver(queueUpdate).observe(timeline);
    configureMotion();
  }
</script>
