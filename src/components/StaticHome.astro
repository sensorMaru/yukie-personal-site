---
import { site } from '../content/site';
import ExperienceTimeline from './ExperienceTimeline.astro';
import ProjectShowcase from './ProjectShowcase.astro';
const { preview = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preview && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#210203" />
    <title>{site.title}</title>
  </head>
  <body>
    <main>
    <section class="hero" id="top" aria-labelledby="home-title">
      <figure class="portrait-scene">
        <img src="/profile/eye-follow-v1/hero-original.png" width="1672" height="941" alt="Yukie的数字人形象" fetchpriority="high" />
      </figure>
      <div class="mobile-shade" aria-hidden="true"></div>
      <header>
        <a class="brand" href="#top">Yukie<span aria-hidden="true">✳</span></a>
        <nav aria-label="首页导航"><a href="#experience">经历</a><a href="#projects">项目</a><a href="#about">关于我</a></nav>
        <button class="contact" data-contact-open>Get in touch ↗</button>
      </header>
      <section class="intro" aria-labelledby="home-title">
        <p class="eyebrow">你好，我是宋雨嘉 / Yukie</p>
        <h1 id="home-title">AI产品经理 <span>/ 产品经理</span></h1>
        <p class="description">{site.hero.body}</p>
        <div class="actions"><a class="button" href="#projects">看看我的项目 <span>↗</span></a><button class="button secondary" data-contact-open>和我聊聊 <span>↗</span></button></div>
      </section>
    </section>
    <section class="details" id="details" aria-label="个人经历与项目">
      <ExperienceTimeline />
      <ProjectShowcase />
      <div class="details-grid">
        {site.sections.filter(section => !['experience', 'projects'].includes(section.id)).map((section,index)=><article class="details-panel" id={section.id}><p class="details-index">{String(index+3).padStart(2,'0')}</p><h2>{section.title}</h2></article>)}
      </div>
    </section>
    </main>
    <dialog aria-labelledby="contact-title"><button class="close" aria-label="关闭" data-close>×</button><h2 id="contact-title">一起聊聊</h2><img src={site.contact.qrSrc} alt="Yukie的微信二维码" /><p>{site.contact.caption}</p></dialog>
    <script>
      const dialog = document.querySelector('dialog');
      document.querySelectorAll('[data-contact-open]').forEach(button=>button.addEventListener('click',()=>dialog?.showModal()));
      document.querySelector('[data-close]')?.addEventListener('click',()=>dialog?.close());
      dialog?.addEventListener('click', event => { if (event.target === dialog) { const r=dialog.getBoundingClientRect(); if(event.clientX<r.left || event.clientX>r.right || event.clientY<r.top || event.clientY>r.bottom) dialog.close(); } });
    </script>
  </body>
</html>
<style is:global>
  *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#210203;color:#fff5ed;font-family:Arial,"PingFang SC","Microsoft YaHei",sans-serif}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible{outline:2px solid #fff;outline-offset:6px}button:disabled{opacity:.45;cursor:wait}
  html{scroll-behavior:smooth}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  .hero{position:relative;min-height:720px;height:100svh;overflow:hidden;isolation:isolate;background:#210203}
  /* Finish at the exact next-section color without changing the portrait asset. */
  .hero::after{content:'';position:absolute;z-index:0;inset:auto 0 -1px;height:clamp(180px,26svh,300px);background:linear-gradient(to bottom,#170a0c00 0%,#170a0c24 24%,#170a0c80 52%,#170a0cdb 78%,#170a0c 100%);pointer-events:none}
  .portrait-scene{position:absolute;inset:0 0 auto auto;margin:0;width:max(100vw,1279.3px,177.68svh);height:max(720px,100svh);pointer-events:none}.portrait-scene img{position:absolute;inset:0;display:block;width:100%;height:100%}
  .details{padding:18px 4.5vw 80px;background:#170a0c}.details-nav{display:flex;align-items:center;flex-wrap:wrap;gap:8px 26px;padding:0 20px;border:0;font-size:14px;color:#c7aaa7}.details-nav a{padding:10px 0;transition:color .25s}.details-nav a:hover{color:#fff3e9}.details-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;padding-top:32px}.details-panel{min-height:200px;padding:24px;border:1px solid #ffffff20;border-radius:12px;scroll-margin-top:24px}.details-index{font-size:13px;color:#f6cbc799}.details-panel h2{font-size:24px;font-weight:500}
  header{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:32px 4.5vw;gap:24px}
  .brand{font-size:30px;letter-spacing:-1.5px;font-weight:600;display:flex;align-items:center;gap:14px}.brand span{font-size:30px;font-weight:400}nav{display:flex;gap:30px;font-size:16px}.contact{background:none;color:inherit;border:0;padding:6px 0;border-bottom:1px solid #fff8;font-size:17px}
  .intro{position:absolute;z-index:1;left:4.5vw;top:48%;transform:translateY(-50%);width:min(43vw,540px)}.eyebrow{font-size:17px;letter-spacing:.5px;margin:0 0 23px;color:#ffe9dfd9}h1{font-size:clamp(34px,3.45vw,56px);letter-spacing:-1.8px;line-height:1.35;font-weight:500;margin:0 0 25px}h1 span{color:#ffe4dccc}.description{font-size:18px;line-height:1.9;max-width:440px;color:#fff1e9d9;margin:0 0 29px}.actions{display:flex;gap:12px;flex-wrap:wrap}.button{border:1px solid #fff4ed;background:#fff4ed;color:#4c080a;border-radius:30px;padding:12px 21px;font-size:15px;display:inline-flex;gap:25px;align-items:center}.secondary{color:#fff4ed;background:transparent;border-color:#fff4ed80}.button:hover{background:#fff;color:#310508}
  .mobile-shade{display:none}
  dialog{border:1px solid #ffffff30;border-radius:18px;background:#201416;color:#fff5ed;padding:28px;max-width:min(380px,90vw);text-align:center}dialog::backdrop{background:#100507c9;backdrop-filter:blur(8px)}dialog img{width:100%;max-height:55vh;object-fit:contain}dialog h2{font-weight:500}dialog p{font-size:14px}.close{position:absolute;right:12px;top:8px;border:0;background:none;color:inherit;font-size:30px}
  @media(max-width:1000px) and (min-width:721px){.intro{width:43vw}.description{font-size:16px}header{padding-top:26px}nav{gap:18px}}
  @media(max-width:900px){.hero{height:auto;min-height:0;padding-bottom:24px}.portrait-scene{width:1050px;height:591px;right:-145px;top:35px}header{padding:22px 22px}.brand{font-size:26px}header nav{display:none}.contact{font-size:14px}.mobile-shade{display:block;position:absolute;inset:360px 0 0;background:linear-gradient(transparent,#260304 230px)}.intro{position:relative;top:auto;left:auto;right:auto;width:auto;transform:none;margin:450px 24px 28px}.eyebrow{font-size:14px;margin-bottom:12px}h1{font-size:34px;line-height:1.3;margin-bottom:15px}.description{font-size:16px;line-height:1.75;margin-bottom:20px}.button{font-size:14px;padding:10px 16px}.details{padding:32px 24px 48px}.details-grid{grid-template-columns:1fr}.details-nav{display:flex;font-size:14px}}
  @media(max-width:900px){.hero::after{height:160px}.details{padding-top:12px}.details-nav{gap:4px 20px}}
  @media(max-width:650px){.details-nav{padding-inline:4px;gap:2px 18px}}
  #home-title{white-space:nowrap;font-size:clamp(1.75rem,3.2vw,3rem);letter-spacing:-.035em;line-height:1.35}
  @media(max-width:900px){#home-title{font-size:clamp(1.25rem,6vw,2.125rem)}}
</style>
